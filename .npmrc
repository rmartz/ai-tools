# Strict, reproducible installs — the CI gate runs `pnpm install --frozen-lockfile`.
auto-install-peers=true
strict-peer-dependencies=false

# Explicit default (base) registry = npmjs. With the github-packages registry
# declared in .github/dependabot.yml, Dependabot's pnpm resolves every public dep
# against GitHub Packages unless the base is pinned, gets stale metadata, and fails
# the whole grouped update (e.g. "No matching version found for @types/node@26.6.1
# … latest release is 17.0.18"), closing it as "no longer updatable"
# (dependabot-core#15415). Keep it alongside the scoped entry below.
registry=https://registry.npmjs.org/

# @rmartz/* now includes an external GitHub Packages dependency
# (@rmartz/repo-hygiene, consumed as the published CLI). Route only that scope to
# GitHub Packages; everything else stays on the public npm registry. The auth
# token is supplied at install time — locally via ~/.npmrc's GITHUB_PACKAGES_TOKEN,
# in CI via the setup action writing the job's GITHUB_TOKEN to ~/.npmrc.
@rmartz:registry=https://npm.pkg.github.com
